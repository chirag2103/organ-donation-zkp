# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Save the value securely; loss makes existing encrypted records unrecoverable.
WRAPPING_KEY=
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
IPFS_API_URL=http://127.0.0.1:5001
APP_ORIGIN=http://localhost:5173
PORT=3001
CONFIRMATIONS=1
# Optional if ipfs.exe is not on PATH:
# IPFS_BINARY=C:\path\to\ipfs.exe
# ADMIN_PRIVATE_KEY belongs in the administrator CLI environment ONLY, never here.
