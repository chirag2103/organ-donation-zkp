# ── Sepolia testnet deployment ────────────────────────────────────────────
# Get an RPC URL from Alchemy (https://alchemy.com) or Infura (https://infura.io)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key of the deployer account (must hold Sepolia test ETH).
# NEVER commit a real private key. Use a throwaway/test-only account.
DEPLOYER_PRIVATE_KEY=0xyour_private_key_here

# For `npx hardhat verify` on Sepolia Etherscan
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── Optional: Ganache PoA network ─────────────────────────────────────────
GANACHE_URL=http://127.0.0.1:7545
GANACHE_PRIVATE_KEY=
MNEMONIC=test test test test test test test test test test test junk

# ── Optional: gas reporter ────────────────────────────────────────────────
REPORT_GAS=false
COINMARKETCAP_API_KEY=
