pragma circom 2.0.0;
include "circomlib/circuits/poseidon.circom";
include "circomlib/circuits/comparators.circom";
template RoleProof(levels) {
    signal input credential;
    signal input salt;
    signal input pathElements[levels];
    signal input pathIndices[levels];
    signal input merkleRoot;
    signal input roleId;
    signal input nullifier;
    signal input recipient;
    signal input chainId;
    signal input issuer;
    signal input rootVersion;
    component roleBits = Num2Bits(3);
    roleBits.in <== roleId;
    component validRole = LessThan(3);
    validRole.in[0] <== roleId;
    validRole.in[1] <== 6;
    validRole.out === 1;
    component leaf = Poseidon(2);
    leaf.inputs[0] <== credential;
    leaf.inputs[1] <== roleId;
    signal hashes[levels+1];
    signal left[levels];
    signal right[levels];
    component nodes[levels];
    hashes[0] <== leaf.out;
    for (var i=0; i<levels; i++) {
        pathIndices[i] * (pathIndices[i]-1) === 0;
        left[i] <== hashes[i] + pathIndices[i]*(pathElements[i]-hashes[i]);
        right[i] <== pathElements[i] + pathIndices[i]*(hashes[i]-pathElements[i]);
        nodes[i] = Poseidon(2);
        nodes[i].inputs[0] <== left[i];
        nodes[i].inputs[1] <== right[i];
        hashes[i+1] <== nodes[i].out;
    }
    hashes[levels] === merkleRoot;
    component domain[4];
    domain[0] = Poseidon(2);
    domain[0].inputs[0] <== issuer;
    domain[0].inputs[1] <== rootVersion;
    domain[1] = Poseidon(2);
    domain[1].inputs[0] <== chainId;
    domain[1].inputs[1] <== domain[0].out;
    domain[2] = Poseidon(2);
    domain[2].inputs[0] <== recipient;
    domain[2].inputs[1] <== domain[1].out;
    domain[3] = Poseidon(2);
    domain[3].inputs[0] <== salt;
    domain[3].inputs[1] <== domain[2].out;
    component nf = Poseidon(2);
    nf.inputs[0] <== credential;
    nf.inputs[1] <== domain[3].out;
    nf.out === nullifier;
}
component main {public [merkleRoot,roleId,nullifier,recipient,chainId,issuer,rootVersion]} = RoleProof(20);
